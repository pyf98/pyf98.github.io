---
layout: default
---
{% if page.cv_format == 'jsonresume' and site.data.resume %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      {% if page.description %}<p class="post-description">{{ page.description }}</p>{% endif %}
    </header>
    <article>
      <div class="cv">
        {% for data in site.data.resume %}
          {% assign section = data[0] %}
          {% assign entries = data[1] %}
          {% unless site.jsonresume contains section %}{% continue %}{% endunless %}
          {% if entries.size == 0 %}{% continue %}{% endif %}
          <section class="card mt-3 p-3">
            <h3 id="{{ section }}" class="card-title font-weight-medium">{{ section | capitalize }}</h3>
            {% case section %}
              {% when 'work', 'internships' %}
                {% include resume/work.liquid %}
              {% when 'education', 'awards', 'basics', 'services', 'teaching' %}
                {% assign partial = section | prepend: 'resume/' | append: '.liquid' %}
                {% include {{ partial }} %}
              {% when 'volunteer' %}
                {% include cv/experience.liquid %}
              {% else %}
                {% assign partial = section | prepend: 'cv/' | append: '.liquid' %}
                {% include {{ partial }} %}
            {% endcase %}
          </section>
        {% endfor %}
      </div>
    </article>
  </div>
{% else %}
  {% al_folio_cv_render %}
{% endif %}
